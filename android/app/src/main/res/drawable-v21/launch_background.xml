<?xml version="1.0" encoding="utf-8"?>
<!-- The window while the Flutter engine starts (Android 11 and earlier): the
     felt's navy with the mark centred (#97), no white flash. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_navy" />
    <item>
        <bitmap android:gravity="center" android:src="@drawable/launch_mark" />
    </item>
</layer-list>
